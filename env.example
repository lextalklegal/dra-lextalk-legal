# Local development: copy to .dev.vars (never commit .dev.vars)
# Use a long, random one-time key for first admin creation.
ADMIN_BOOTSTRAP_KEY=replace-with-a-long-random-secret

# Optional email verification (requires a verified sender/domain with Resend).
# RESEND_API_KEY=
# EMAIL_FROM=verified-sender@example.com
# AUTH_PEPPER=replace-with-a-separate-random-secret

# Payments: add only when ready to use Razorpay test mode.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
